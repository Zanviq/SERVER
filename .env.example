# ── 환경변수 이름 목록 (값은 넣지 않는다. 비밀값은 커밋 금지) ──────────────
#
# 서버(TwoMES Hosting): 대시보드 → 앱 → 환경변수 탭에 넣는다. 플랫폼이 배포 때마다
#   compose 파일 옆에 .env 로 써 주고, HOSTING_APP·HOSTING_DATA_DIR 도 거기에 더한다.
# 로컬: 복사해서 .env 로 쓴다 (.env 는 git 제외).
#
# 주석(#)으로 둔 줄은 선택값이다. 비워 둔 채로 주석을 풀지 말 것 — 빈 문자열은 '설정 안 함'이
# 아니라 '빈 값'이라, 숫자 변수(SESSION_TTL_SECONDS·AI_MAX_STEPS·MAX_UPLOAD_BYTES)는
# 백엔드가 뜨지 못하고 GEMINI_MODEL 은 빈 모델 이름이 된다. 쓰지 않으면 줄째로 빼 둔다.

# ===== 플랫폼이 넣어 주는 값 (직접 넣지 않는다) =====
# 저장공간 경로. 서버에서는 기존 /mnt/server. 로컬에서 비우면 ./data
# HOSTING_DATA_DIR=
# 앱 slug
# HOSTING_APP=

# ===== 반드시 설정 =====
# AUTH_USERS 는 **최초 관리자 부트스트랩 전용**이다. 저장소에 accounts.json 이 없을 때
# 한 번만 해시로 바꿔 관리자 계정을 만든다. 이후 계정의 단일 출처는 accounts.json 이며,
# 추가 계정은 웹에서 회원가입 → 관리자 승인으로 만든다(롤백용으로 남겨 둔다).
#   형식: [{"username":"아이디","password":"비밀번호","display_name":"표시이름"}]
AUTH_USERS=
# 세션 토큰 서명용 비밀키 (길고 무작위로). 비어 있으면 로그인이 거부된다.
SESSION_SECRET=

# ===== 저장소 (도커 밖에서 돌릴 때만) =====
# 컨테이너 안에서는 compose 가 /mnt/server 로 덮어쓴다. 로컬에서 uvicorn 으로 직접 돌리면 ./data
# STORAGE_ROOT=

# ===== 접속·보안 =====
# HTTPS(server.zanviq.dev, 플랫폼 터널)로만 접속하면 true. 로컬 http 개발은 false (기본 false)
# COOKIE_SECURE=
# 자격증명 쿠키를 쓰므로 '*' 금지. 실제 접속 오리진을 콤마로 (기본 http://localhost:5173,http://localhost:4173)
# CORS_ORIGINS=
# 세션 유효시간(초, 기본 3600). 실제 길이는 계정별 설정이 정한다.
# SESSION_TTL_SECONDS=
# true 일 때만 오류 응답에 상세(예외/경로)를 노출 (기본 false)
# DEBUG=
# 업로드 1건 최대 크기(바이트, 기본 2147483648 = 2GB)
# MAX_UPLOAD_BYTES=
# 컨테이너 시계 (기본 Asia/Seoul — compose 에도 기본값이 있다). 저장·표시 시각이 전부 한국 시간이다.
# TZ=

# ===== AI (Gemini) =====
# 없으면 AI 대화·논문 추출·회의 받아쓰기만 꺼지고 나머지는 정상 동작
GEMINI_API_KEY=
# 서버 기본 모델 (기본 gemini-2.5-flash)
# GEMINI_MODEL=
# ReAct 에이전트 1턴 최대 스킬 실행 횟수 (기본 8)
# AI_MAX_STEPS=

# ===== Google Calendar 웹 OAuth (선택, 앱 공통) =====
# Google Cloud Console 의 OAuth 클라이언트(웹 애플리케이션). 승인된 리디렉션 URI 에
# GOOGLE_REDIRECT_URI 와 똑같은 값(https://server.zanviq.dev/api/google/callback)을 등록한다.
# 설정하면 설정 화면의 "Google 캘린더 연동" 버튼으로 계정별 연동이 끝난다.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# ===== Google Calendar 구 방식 (하위호환, 유저별) =====
# "<아이디>_" 접두사를 붙이면 그 유저의 캘린더에만 연결된다. 위 OAuth 로 연동한 토큰이 우선한다.
# 두 번째 유저가 있다면 bob_GOOGLE_CLIENT_ID 처럼 각자 추가.
# admin_GOOGLE_CLIENT_ID=
# admin_GOOGLE_CLIENT_SECRET=
# admin_GOOGLE_REFRESH_TOKEN=
# 캘린더 ID (기본 primary)
# admin_GOOGLE_CALENDAR_ID=
# 서비스 계정 JSON 경로 — 위 세 개 대신 쓰는 방법
# admin_GOOGLE_SERVICE_ACCOUNT_JSON=

# ===== 외부 SSH 안내 (선택) =====
# 대시보드 'SSH 카드'에 클라이언트 설정을 보여 주는 데만 쓴다. 터널 라우팅과는 무관하다
# (라우팅은 플랫폼 터널의 HOSTING_EXTRA_INGRESS — README 'TwoMES Hosting 으로 배포').
# 터널로 내보낸 SSH 호스트 이름. 예: ssh.zanviq.dev
# SSH_PUBLIC_HOSTNAME=
# 라즈베리파이 사용자. 비우면 <계정> 자리표시자
# SSH_USER=

# ===== 웹 터미널 (admin 전용, 옵트인) =====
# ⚠️ 켜면 주인 계정이 라즈베리파이 '호스트' 루트 셸에 접속할 수 있다(nsenter).
#    반드시 주인 비밀번호를 강하게 설정한 뒤에만 켤 것.
# 켜기: ENABLE_TERMINAL=true + compose 프로필 terminal (플랫폼 앱 설정의 프로필)
# ENABLE_TERMINAL=
# 터미널 사용 가능 계정(콤마구분, 기본 admin)
# TERMINAL_ADMINS=
# CSWSH 방지용 허용 Origin(콤마구분). 비우면 요청 Host 와 동일 출처만 허용. 예: https://server.zanviq.dev
# TERMINAL_ORIGINS=
