# 환경변수 / 비밀
.env
*.env
!.env.example

# 로컬 개발용 저장소
/data/
backend/data/
# 브라우저로 직접 확인할 때 쓰는 격리 저장소.
# `_` 로 시작하는 이름을 쓰면 안 된다 — 이 저장소에서 `_*` 는 "지워도 되는
# 임시 파일" 규약이라, 정리하다 실제로 통째로 날아간 적이 있다.
/devdata-local/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Node / React
node_modules/
frontend/dist/
frontend/build/
.next/

# OS / 에디터
.DS_Store
Thumbs.db
.vscode/
.idea/


# 브라우저 자동화 산출물(콘솔 로그·스크린샷)
.playwright-mcp/

# 로컬 검증용 개발 서버 스크립트
